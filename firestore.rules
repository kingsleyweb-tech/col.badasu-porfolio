rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The administrator is the Firebase Auth account whose uid is recorded in portfolio/admin_account.
    function adminAccount() {
      return get(/databases/$(database)/documents/portfolio/admin_account).data;
    }
    function isAdmin() {
      return request.auth != null && adminAccount().get('uid', '') == request.auth.uid;
    }
    // One-time switch from the old stored password to Firebase Auth. The record has no account id
    // yet, the signed-in account has the recorded email, and it proves that email is its own:
    // either the write carries the stored password (claimPass, never readable) or Firebase has
    // verified the email (for example through the password reset link). Only uid and claimPass change.
    function canClaimAdmin() {
      return request.auth != null
        && resource != null
        && resource.data.get('uid', '') == ''
        && request.auth.token.email != null
        && request.auth.token.email.lower() == resource.data.get('email', '').lower()
        && request.resource.data.get('uid', '') == request.auth.uid
        && (
          request.auth.token.get('email_verified', false) == true
          || (resource.data.get('pass', '') != '' && request.resource.data.get('claimPass', '') == resource.data.pass)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'claimPass']);
    }

    // Who the administrator is: never public.
    match /portfolio/admin_account {
      allow read: if isAdmin();
      allow update: if isAdmin() || canClaimAdmin();
      allow create, delete: if false;
    }

    // Obsolete shared session record from the old login; only the administrator may remove it.
    match /portfolio/admin_session {
      allow read, create, update: if false;
      allow delete: if isAdmin();
    }

    // Portfolio content is protected: only the administrator reads or writes it directly. Visitors
    // receive it from /api/portfolio after the server has checked their access-code session.
    match /portfolio/{docId} {
      allow read, write: if isAdmin() && docId != 'admin_account' && docId != 'admin_session';
    }

    // Content-free change markers that open pages watch to refresh or re-check access.
    // content: { updatedAt } written by the administrator when saving.
    // access:  { enabled, codeVersion, epoch } written only by the server.
    match /site_meta/content {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site_meta/access {
      allow read: if true;
      allow write: if false;
    }

    // Gallery records kept alongside Cloudinary (admin dashboard only).
    match /gallery_collections/{docId} {
      allow read, write: if isAdmin();
    }
    match /gallery_images/{docId} {
      allow read, write: if isAdmin();
    }
    match /deleted_collections/{docId} {
      allow read, write: if isAdmin();
    }

    // Access control (access_control, visitor_sessions, access_logs, access_rate_limits) is
    // server-only: the rule below closes it to every browser, including the administrator's.

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
