rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write access to portfolio data & deleted collections so admin edits persist live on the public website
    match /portfolio/{document=**} {
      allow read, write: if true;
    }
    match /deleted_collections/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
